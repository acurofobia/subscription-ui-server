HOST=127.0.0.1
PORT=8082
SUBSCRIPTION_TOKEN=replace_with_a_random_url_safe_token
SING_BOX_CONFIG_PATH=./config.json
VK_TURN_LINK=""
UI_DOCUMENT_PATH=./data/subscription.json

# sing-box (existing raw config), vless-failover (native JSON), or xray (local graph).
VPN_CONFIG_FORMAT=sing-box
# Native setup: SING_BOX_CONFIG_PATH=./config.failover.json
#              VPN_CONFIG_FORMAT=vless-failover

# Explicit HTTPS origin, optionally with a reverse-proxy mount path.
PUBLIC_BASE_URL=
# Set /api/sub to match the routes used by the VPN backend.
SUBSCRIPTION_PATH_PREFIX=/subscription
APP_USER_AGENT_PREFIX=VipinApp/
# Optional: at least 32 bytes, used only for native /app/v1/* Bearer tokens.
APP_SUBSCRIPTION_SIGNING_SECRET=
